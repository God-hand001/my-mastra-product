{
  "name": "jlc-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "desktop": "electron .",
    "desktop:dev": "electron . --dev",
    "dist": "cd ../app && npm run build && cd ../app-desktop && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.jlc.bangong",
    "productName": "嘉立创办公",
    "files": [
      "main.js",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "../app/dist",
        "to": "dist"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "release"
    },
    "extraMetadata": {
      "main": "main.js"
    }
  }
}
