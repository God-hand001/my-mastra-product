{
  "name": "filesystem",
  "description": "读写本地文件系统的 MCP 服务器，作用范围为工作区根目录。",
  "transport": "stdio",
  "command": "npx",
  "args": [
    "-y",
    "@modelcontextprotocol/server-filesystem",
    "${ROOT}"
  ],
  "env": {},
  "capabilities": {
    "network": true,
    "externalWrite": [
      "${NPMCACHE}"
    ]
  }
}
